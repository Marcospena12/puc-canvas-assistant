# Canvas (obrigatório)
CANVAS_BASE_URL=https://sua-instituicao.instructure.com
CANVAS_TOKEN=

# Telegram (necessário apenas para rodar o bot)
# Crie o bot com @BotFather e pegue seu id com @userinfobot.
# Configure TELEGRAM_CHAT_ID e/ou TELEGRAM_ALLOWED_USER_IDS: sem isso o bot não inicia.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# IDs de usuários do Telegram autorizados, separados por vírgula
TELEGRAM_ALLOWED_USER_IDS=

# LLM: ollama (padrão), openai, grok ou gemini
LLM_PROVIDER=ollama
LLM_MODEL=qwen3:14b
# Deixe LLM_BASE_URL vazio para usar o padrão do provider.
# qwen3:14b: recomenda-se LLM_THINK=false (mais rápido); true melhora raciocínio.
LLM_BASE_URL=
LLM_API_KEY=
LLM_THINK=false
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=800
LLM_NUM_CTX=8192
LLM_TIMEOUT_SECONDS=180

# Cache e sincronização
DB_PATH=data/assistant.sqlite3
TIMEZONE=America/Sao_Paulo
POLL_INTERVAL_MINUTES=20
SYNC_PAST_DAYS=7
SYNC_FUTURE_DAYS=30
ANNOUNCEMENTS_LOOKBACK_DAYS=60
LOG_LEVEL=INFO

# Identificador do usuário (fase single-user; já preparado para multiusuário)
USER_ID=default
