# Canvas (obrigatório)
CANVAS_BASE_URL=https://sua-instituicao.instructure.com
CANVAS_TOKEN=

# Telegram (necessário apenas para rodar o bot)
# Crie o bot com @BotFather e pegue seu id com @userinfobot.
# Configure TELEGRAM_CHAT_ID e/ou TELEGRAM_ALLOWED_USER_IDS: sem isso o bot não inicia.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# IDs de usuários do Telegram autorizados, separados por vírgula
TELEGRAM_ALLOWED_USER_IDS=

# LLM: ollama (padrão), openai, grok, gemini ou anthropic
LLM_PROVIDER=ollama
# Modelos sugeridos:
#   - Local via Ollama: qwen3:14b (padrão recomendado) ou qwen3:8b
#   - Anthropic (docs.claude.com, geração 5.5, suportam tool use, 1M de contexto):
#       claude-haiku-5-5 (mais rápido, $0.10/$0.50 por MTok)
#       claude-sonnet-5-5 (equilíbrio, $2/$10 por MTok)
#       claude-opus-5-5 (mais capaz, $4/$20 por MTok)
LLM_MODEL=qwen3:14b
# AGENT_MODEL: se vazio, usa LLM_MODEL
AGENT_MODEL=
# Deixe LLM_BASE_URL vazio para usar o padrão do provider.
# qwen3:14b: recomenda-se LLM_THINK=false (mais rápido); true melhora raciocínio.
LLM_BASE_URL=
LLM_API_KEY=
ANTHROPIC_API_KEY=
LLM_THINK=false
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=800
LLM_NUM_CTX=16384
LLM_TIMEOUT_SECONDS=180
LLM_KEEP_ALIVE=30m

# Comandos de estudo com LLM (Fase 3.4) e tutor de tarefas (Fase 4.1)
# STUDY_MODEL: se vazio, usa o mesmo modelo configurado no agente (LLM_MODEL)
# Opções Anthropic: claude-haiku-5-5, claude-sonnet-5-5, claude-opus-5-5
# Opções Ollama: qwen3:14b
STUDY_MODEL=
STUDY_TOP_K=8
STUDY_CONTEXT_MAX_TOKENS=6000
STUDY_MAX_OUTPUT_TOKENS=1200
STUDY_SUMMARY_MAX_CHUNKS=40
STUDY_GROUNDING_MIN_OVERLAP=0.35

# Notificações proativas
NOTIFY_ENABLED=true
NOTIFY_NEW_ASSIGNMENTS=true
NOTIFY_NEW_PAGES=true
# Janelas de lembrete antes do prazo, em horas (separadas por vírgula)
NOTIFY_DUE_HOURS=24,2
NOTIFY_ANNOUNCEMENTS=true
NOTIFY_NEW_FILES=true
NOTIFY_DIGEST=true
NOTIFY_DIGEST_TIME=08:00
# Janela de silêncio; use o mesmo horário nos dois campos para desativar
NOTIFY_QUIET_START=22:00
NOTIFY_QUIET_END=07:00
NOTIFY_MAX_STALE_MINUTES=45
NOTIFY_CHECK_MINUTES=5
NOTIFY_DIGEST_GRACE_MINUTES=120

# Catch-up ao iniciar (Etapa A 4.1.2): se a lacuna desde o último ciclo do scheduler
# for maior que CATCHUP_GAP_MINUTES, o bot roda um sync e envia UMA mensagem
# consolidada ("Fuitei offline de X a Y. Pendências: ..."). Prazos em menos de
# CATCHUP_URGENT_HOURS ignoram a janela de silêncio.
CATCHUP_GAP_MINUTES=30
CATCHUP_URGENT_HOURS=6

# Heartbeat externo (Etapa A 4.1.2): GET opcional a cada HEARTBEAT_INTERVAL_MINUTES
# para um serviço de monitoramento (ex.: healthchecks.io). Só dispara se o último
# ciclo do scheduler foi bem-sucedido. Sem HEARTBEAT_URL, não faz nada.
# Configure o alerta do serviço (e-mail/Telegram) para avisar quando o bot parar.
HEARTBEAT_URL=
HEARTBEAT_INTERVAL_MINUTES=10

# Incidentes operacionais (alertas únicos e mensagens de recuperação)
INCIDENT_ENABLED=true
INCIDENT_CANVAS_DOWN_MINUTES=10
INCIDENT_LLM_FAILURES=3

# Revisão de rascunho pelo tutor (Etapa B 4.2)
# O bot AVALIA o rascunho contra os critérios da tarefa e APONTA lacunas.
# NÃO reescreve seções nem gera parágrafos substitutos. NÃO escreve no Canvas.
REVIEW_SESSION_MINUTES=30
REVIEW_MAX_FILE_MB=10
REVIEW_MAX_CHARS=20000
REVIEW_MAX_TEXT_CHARS=4000
# REVIEW_PERSIST_DRAFTS=false: o texto do rascunho NÃO é persistido (apenas o feedback em cache)
REVIEW_PERSIST_DRAFTS=false

# Base de conhecimento e sincronização de arquivos (Fase 3)
FILE_SYNC_ENABLED=true
FILE_SYNC_INTERVAL_MINUTES=60
FILES_DIR=data/files
FILE_MAX_SIZE_MB=50
FILE_ALLOWED_TYPES=pdf,pptx,docx,txt,md
FILE_BLOCKED_RETRY_HOURS=24
FILE_DOWNLOAD_RETRY_HOURS=6
FILE_DOWNLOAD_TIMEOUT_SECONDS=120

# Sincronização de conteúdo do Canvas (páginas, tarefas, avisos, ementas - Fase 3.5)
CONTENT_SYNC_ENABLED=true
CONTENT_SYNC_INTERVAL_MINUTES=60
CONTENT_BLOCKED_RETRY_HOURS=24

# Cache e sincronização
DB_PATH=data/assistant.sqlite3
TIMEZONE=America/Sao_Paulo
POLL_INTERVAL_MINUTES=20
SYNC_PAST_DAYS=7
SYNC_FUTURE_DAYS=30
ANNOUNCEMENTS_LOOKBACK_DAYS=60
LOG_LEVEL=INFO

# Identificador do usuário (fase single-user; já preparado para multiusuário)
USER_ID=default
